{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "id",
    "execution_profile",
    "operation",
    "output_scope",
    "representatives",
    "input_files",
    "brand_asset_mode",
    "output_files"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "execution_profile": {
      "const": "bound-production-v1"
    },
    "operation": {
      "type": "string",
      "minLength": 1
    },
    "input_files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "output_files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "brand_asset_mode": {
      "enum": [
        "restricted",
        "not-used"
      ]
    },
    "asset_scope": {
      "type": "object",
      "required": [
        "basis",
        "allowed_assets",
        "used_origins"
      ],
      "properties": {
        "basis": {
          "type": "object",
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "allowed_assets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        },
        "used_origins": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    },
    "main_visual_action": {
      "enum": [
        "create",
        "replace",
        "layout-only",
        "local-composite"
      ]
    },
    "main_visual_source": {
      "enum": [
        "generated",
        "edited",
        "user-asset"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "brand_asset_mode": {
            "const": "restricted"
          }
        }
      },
      "then": {
        "required": [
          "asset_scope"
        ]
      }
    }
  ]
}
