{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "id",
    "execution_profile",
    "operation",
    "output_scope",
    "representatives",
    "input_files",
    "brand_asset_mode",
    "output_files"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "execution_profile": {
      "const": "bound-production-v1"
    },
    "operation": {
      "type": "string",
      "minLength": 1
    },
    "input_files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "output_files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "brand_asset_mode": {
      "enum": [
        "restricted",
        "not-used"
      ]
    },
    "asset_scope": {
      "type": "object",
      "required": [
        "basis",
        "allowed_assets",
        "used_origins"
      ],
      "properties": {
        "basis": {
          "type": "object",
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "allowed_assets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        },
        "used_origins": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    },
    "main_visual_action": {
      "enum": [
        "create",
        "replace",
        "layout-only",
        "local-composite"
      ]
    },
    "main_visual_source": {
      "enum": [
        "generated",
        "edited",
        "user-asset"
      ]
    },
    "product_contract": {
      "const": "print-product-v2"
    },
    "product_operation": {
      "enum": [
        "generate",
        "edit",
        "not-related"
      ]
    },
    "product_targets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "element_id": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "enum": [
              "scene-object",
              "display-object"
            ]
          }
        },
        "required": [
          "element_id",
          "role"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "product_plan_record": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "prepared_at": {
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "brand_asset_mode": {
            "const": "restricted"
          }
        }
      },
      "then": {
        "required": [
          "asset_scope"
        ]
      }
    },
    {
      "if": {
        "required": [
          "product_contract"
        ]
      },
      "then": {
        "required": [
          "product_operation",
          "product_targets"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "product_operation": {
                  "enum": [
                    "generate",
                    "edit"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "product_plan_record",
                "prepared_at"
              ],
              "properties": {
                "product_targets": {
                  "minItems": 1
                }
              }
            },
            "else": {
              "properties": {
                "product_targets": {
                  "maxItems": 0
                }
              },
              "not": {
                "required": [
                  "product_plan_record"
                ]
              }
            }
          }
        ]
      }
    }
  ]
}
