{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.student-ad-competition-copilot/schemas/marketing-plan-run-manifest.schema.json",
  "title": "Marketing-plan production run manifest",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "competition",
    "category",
    "proposition_id",
    "selected_direction",
    "run_scope",
    "visual_generation_capability",
    "method_cards_used",
    "method_cards_rejected",
    "directions",
    "artifacts",
    "review_contract"
  ],
  "properties": {
    "schema_version": {
      "const": "0.4.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "competition": {
      "enum": [
        "daguangsai",
        "academy-award"
      ]
    },
    "category": {
      "const": "marketing-plan"
    },
    "proposition_id": {
      "type": "string",
      "minLength": 1
    },
    "selected_direction": {
      "type": "string",
      "minLength": 1
    },
    "run_scope": {
      "enum": [
        "concept-only",
        "production-candidate",
        "delivery-candidate"
      ]
    },
    "visual_generation_capability": {
      "type": "object",
      "required": [
        "status",
        "provider",
        "operations",
        "checked_at",
        "evidence",
        "user_decision",
        "impact_acknowledged"
      ],
      "properties": {
        "status": {
          "enum": [
            "available",
            "unavailable",
            "unknown"
          ]
        },
        "provider": {
          "type": [
            "string",
            "null"
          ]
        },
        "operations": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "generate",
              "edit"
            ]
          }
        },
        "checked_at": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        },
        "user_decision": {
          "enum": [
            "use-available-capability",
            "accept-limited-mode",
            "enable-or-switch-environment",
            "pending"
          ]
        },
        "impact_acknowledged": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "available"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "provider": {
                "type": "string",
                "minLength": 1
              },
              "operations": {
                "contains": {
                  "const": "generate"
                }
              },
              "user_decision": {
                "const": "use-available-capability"
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "aigc_used": {
      "enum": [
        "yes",
        "no",
        "unknown"
      ]
    },
    "method_cards_used": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "method_cards_rejected": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "directions": {
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": [
          "direction_id",
          "one_line_strategy",
          "status"
        ],
        "properties": {
          "direction_id": {
            "type": "string",
            "minLength": 1
          },
          "one_line_strategy": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "selected",
              "rejected"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "final_artifact": {
      "type": "object",
      "required": [
        "path",
        "sha256",
        "slide_count",
        "authoring_mode"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "slide_count": {
          "type": "integer",
          "minimum": 1
        },
        "authoring_mode": {
          "const": "native-editable-pptx"
        }
      },
      "additionalProperties": false
    },
    "artifacts": {
      "type": "object",
      "required": [
        "brief_evidence",
        "brief_constraints",
        "research_synthesis",
        "evidence_register",
        "reference_review",
        "direction_cards",
        "method_application",
        "concept_gate",
        "quality_gate_results",
        "run_status"
      ],
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "review_contract": {
      "type": "string",
      "minLength": 1
    },
    "award_review_requested": {
      "type": "boolean"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "run_scope": {
            "enum": [
              "production-candidate",
              "delivery-candidate"
            ]
          }
        },
        "required": [
          "run_scope"
        ]
      },
      "then": {
        "required": [
          "aigc_used"
        ],
        "properties": {
          "visual_generation_capability": {
            "properties": {
              "status": {
                "const": "available"
              }
            }
          },
          "artifacts": {
            "required": [
              "page_blueprint",
              "budget_kpi",
              "sample_review"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "run_scope": {
            "const": "delivery-candidate"
          }
        },
        "required": [
          "run_scope"
        ]
      },
      "then": {
        "required": [
          "final_artifact"
        ],
        "properties": {
          "aigc_used": {
            "enum": [
              "yes",
              "no"
            ]
          },
          "artifacts": {
            "required": [
              "full_deck_review",
              "technical_validation"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "aigc_used": {
            "const": "yes"
          }
        },
        "required": [
          "aigc_used"
        ]
      },
      "then": {
        "properties": {
          "artifacts": {
            "required": [
              "aigc_record"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "run_scope": {
            "enum": [
              "production-candidate",
              "delivery-candidate"
            ]
          }
        },
        "required": [
          "run_scope"
        ]
      },
      "then": {
        "properties": {
          "artifacts": {
            "required": [
              "visual_review"
            ]
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
