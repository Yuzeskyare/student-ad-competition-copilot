{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Final pixel evidence",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "schema_version",
        "run_id",
        "run_scope",
        "units"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "run_scope": {
          "enum": [
            "production-candidate",
            "delivery-candidate"
          ]
        },
        "units": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "artifact",
              "render_record",
              "checks",
              "visible_elements",
              "typography",
              "containers",
              "products"
            ],
            "properties": {
              "artifact": {
                "type": "object"
              },
              "render_record": {
                "type": "object"
              },
              "checks": {
                "type": "array"
              },
              "visible_elements": {
                "type": "array"
              },
              "typography": {
                "type": "array"
              },
              "containers": {
                "type": "array"
              },
              "products": {
                "type": "array"
              },
              "preserved_regions": {
                "type": "array"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "schema_version",
        "run_id",
        "run_scope",
        "units"
      ],
      "properties": {
        "schema_version": {
          "const": "2.0.0"
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "run_scope": {
          "enum": [
            "production-candidate",
            "delivery-candidate"
          ]
        },
        "units": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "artifact",
              "render_record",
              "checks",
              "critical_review",
              "issues"
            ],
            "properties": {
              "artifact": {
                "type": "object"
              },
              "render_record": {
                "type": "object"
              },
              "checks": {
                "type": "array"
              },
              "preserved_regions": {
                "type": "array"
              },
              "critical_review": {
                "type": "array",
                "minItems": 3
              },
              "issues": {
                "type": "array"
              }
            },
            "additionalProperties": false
          },
          "minItems": 1
        }
      },
      "additionalProperties": false
    }
  ]
}
