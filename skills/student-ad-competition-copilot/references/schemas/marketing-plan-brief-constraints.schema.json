{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.student-ad-competition-copilot/schemas/marketing-plan-brief-constraints.schema.json",
  "title": "Marketing-plan proposition constraints",
  "type": "object",
  "required": ["schema_version", "competition", "proposition_id", "category_authorized", "required_sections", "budget_requirement", "kpi_requirement", "evidence"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "competition": {"enum": ["daguangsai", "academy-award"]},
    "proposition_id": {"type": "string", "minLength": 1},
    "category_authorized": {"type": "boolean"},
    "required_sections": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "required_terms": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "prohibited_terms": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "budget_requirement": {"enum": ["required", "recommended", "not-required", "not-specified"]},
    "kpi_requirement": {"enum": ["required", "recommended", "not-required", "not-specified"]},
    "research_requirement": {"enum": ["required", "recommended", "not-required", "not-specified"]},
    "allowed_page_shapes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["16:9", "A4"]}
    },
    "notes": {"type": "string"},
    "evidence": {
      "type": "object",
      "required": ["source", "checked_at"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "checked_at": {"type": "string", "minLength": 1},
        "notes": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
