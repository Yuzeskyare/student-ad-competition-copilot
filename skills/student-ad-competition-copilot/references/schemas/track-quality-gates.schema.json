{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.student-ad-competition-copilot/schemas/track-quality-gates.schema.json",
  "title": "Track quality-gate definitions and run results",
  "oneOf": [
    {"$ref": "#/$defs/gateDefinitionSet"},
    {"$ref": "#/$defs/gateResultSet"}
  ],
  "$defs": {
    "track": {
      "enum": ["print-ad", "ad-copy", "marketing-plan"]
    },
    "applicability": {
      "oneOf": [
        {
          "type": "object",
          "required": ["mode"],
          "properties": {"mode": {"const": "always"}},
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["mode", "when"],
          "properties": {
            "mode": {"const": "conditional"},
            "when": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        }
      ]
    },
    "checkDefinition": {
      "type": "object",
      "required": [
        "check_id", "assessment", "question", "pass_condition",
        "failure_severity", "evidence_required"
      ],
      "properties": {
        "check_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "assessment": {"enum": ["human", "machine"]},
        "question": {"type": "string", "minLength": 1},
        "pass_condition": {"type": "string", "minLength": 1},
        "applies_when": {"type": "string", "minLength": 1},
        "failure_severity": {"enum": ["consider", "return-on-observed-failure", "hard-stop"]},
        "return_to_stage": {"type": "string", "minLength": 1},
        "evidence_required": {"type": "boolean"}
      },
      "allOf": [
        {
          "if": {
            "properties": {"failure_severity": {"enum": ["hard-stop", "return-on-observed-failure"]}},
            "required": ["failure_severity"]
          },
          "then": {"required": ["return_to_stage"]}
        }
      ],
      "additionalProperties": false
    },
    "hardStopDefinition": {
      "type": "object",
      "required": ["stop_id", "condition", "return_to_stage", "required_resolution"],
      "properties": {
        "stop_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "condition": {"type": "string", "minLength": 1},
        "return_to_stage": {"type": "string", "minLength": 1},
        "required_resolution": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "waiverPolicy": {
      "type": "object",
      "required": ["allowed", "reason_required", "allowed_when"],
      "properties": {
        "allowed": {"type": "boolean"},
        "reason_required": {"type": "boolean"},
        "allowed_when": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"allowed": {"const": false}}, "required": ["allowed"]},
          "then": {"properties": {"allowed_when": {"maxItems": 0}}}
        }
      ],
      "additionalProperties": false
    },
    "gateDefinition": {
      "type": "object",
      "required": [
        "gate_id", "order", "stage", "gate_type", "purpose",
        "applicability", "required_inputs", "required_outputs", "checks",
        "hard_stops", "waiver_policy", "on_pass"
      ],
      "properties": {
        "gate_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*\\.[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "order": {"type": "integer", "minimum": 1},
        "stage": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "gate_type": {"enum": ["human", "machine", "hybrid"]},
        "purpose": {"type": "string", "minLength": 1},
        "applicability": {"$ref": "#/$defs/applicability"},
        "required_inputs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "required_outputs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/checkDefinition"}
        },
        "hard_stops": {
          "type": "array",
          "items": {"$ref": "#/$defs/hardStopDefinition"}
        },
        "waiver_policy": {"$ref": "#/$defs/waiverPolicy"},
        "on_pass": {"type": ["string", "null"], "minLength": 1}
      },
      "additionalProperties": false
    },
    "gateDefinitionSet": {
      "type": "object",
      "required": [
        "$schema", "document_type", "schema_version", "definition_set_id",
        "track", "playbook", "gates"
      ],
      "properties": {
        "$schema": {"type": "string", "minLength": 1},
        "document_type": {"const": "gate-definitions"},
        "schema_version": {"const": "0.1.0"},
        "definition_set_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$"},
        "track": {"$ref": "#/$defs/track"},
        "playbook": {"type": "string", "minLength": 1},
        "gates": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/gateDefinition"}
        }
      },
      "additionalProperties": false
    },
    "reviewer": {
      "type": "object",
      "required": ["type", "source"],
      "properties": {
        "type": {"enum": ["human", "machine"]},
        "source": {"type": "string", "minLength": 1},
        "identity": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "gateResult": {
      "type": "object",
      "required": [
        "gate_id", "status", "evidence_paths", "reviewers", "passed_check_ids",
        "failed_check_ids", "boundaries", "waiver_reason", "checked_at", "notes"
      ],
      "properties": {
        "gate_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*\\.[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "status": {"enum": ["not-run", "in-progress", "pass", "pass-with-boundaries", "fail", "waived"]},
        "evidence_paths": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "reviewers": {
          "type": "array",
          "items": {"$ref": "#/$defs/reviewer"}
        },
        "passed_check_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"}
        },
        "failed_check_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"}
        },
        "boundaries": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "waiver_reason": {"type": ["string", "null"]},
        "checked_at": {"type": ["string", "null"], "format": "date-time"},
        "notes": {"type": ["string", "null"]}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"enum": ["pass", "pass-with-boundaries", "fail", "waived"]}}, "required": ["status"]},
          "then": {
            "properties": {
              "evidence_paths": {"minItems": 1},
              "reviewers": {"minItems": 1},
              "checked_at": {"type": "string", "format": "date-time"}
            }
          }
        },
        {
          "if": {"properties": {"status": {"const": "pass-with-boundaries"}}, "required": ["status"]},
          "then": {"properties": {"boundaries": {"minItems": 1}}}
        },
        {
          "if": {"properties": {"status": {"const": "fail"}}, "required": ["status"]},
          "then": {"properties": {"failed_check_ids": {"minItems": 1}}}
        },
        {
          "if": {"properties": {"status": {"const": "waived"}}, "required": ["status"]},
          "then": {"properties": {"waiver_reason": {"type": "string", "minLength": 1}}}
        }
      ],
      "additionalProperties": false
    },
    "gateResultSet": {
      "type": "object",
      "required": [
        "$schema", "document_type", "schema_version", "definition_set_id",
        "track", "run_id", "results"
      ],
      "properties": {
        "$schema": {"type": "string", "minLength": 1},
        "document_type": {"const": "gate-results"},
        "schema_version": {"const": "0.1.0"},
        "definition_set_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$"},
        "track": {"$ref": "#/$defs/track"},
        "run_id": {"type": "string", "minLength": 1},
        "results": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/gateResult"}
        }
      },
      "additionalProperties": false
    }
  }
}
