{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.student-ad-competition-copilot/schemas/marketing-plan-delivery-manifest.schema.json",
  "title": "Marketing-plan delivery and evidence manifest",
  "type": "object",
  "required": [
    "schema_version",
    "plan_id",
    "competition",
    "proposition_id",
    "selected_page_shape",
    "artifacts",
    "pages",
    "sections",
    "evidence_status",
    "evidence_register",
    "budget",
    "kpi",
    "submission_fields"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "plan_id": {
      "type": "string",
      "minLength": 1
    },
    "competition": {
      "enum": [
        "daguangsai",
        "academy-award"
      ]
    },
    "proposition_id": {
      "type": "string",
      "minLength": 1
    },
    "selected_page_shape": {
      "enum": [
        "16:9",
        "A4"
      ]
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256",
          "kind"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "kind": {
            "enum": [
              "plan-pdf",
              "page-image"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "sequence",
          "artifact",
          "page_number",
          "role"
        ],
        "properties": {
          "sequence": {
            "type": "integer",
            "minimum": 1
          },
          "artifact": {
            "type": "string",
            "minLength": 1
          },
          "page_number": {
            "type": "integer",
            "minimum": 1
          },
          "role": {
            "enum": [
              "cover",
              "toc",
              "body",
              "appendix",
              "back-cover"
            ]
          },
          "section_id": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "sections": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "submission_fields": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "null"
        ]
      }
    },
    "evidence_status": {
      "enum": [
        "registered",
        "no-external-claims"
      ]
    },
    "evidence_register": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "claim_id",
          "claim",
          "source_title",
          "source_url_or_path",
          "checked_at",
          "used_at",
          "status"
        ],
        "properties": {
          "claim_id": {
            "type": "string",
            "minLength": 1
          },
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "source_title": {
            "type": "string",
            "minLength": 1
          },
          "source_url_or_path": {
            "type": "string",
            "minLength": 1
          },
          "checked_at": {
            "type": "string",
            "minLength": 1
          },
          "used_at": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "status": {
            "enum": [
              "verified",
              "proposition-claim",
              "creative-assumption",
              "open-question"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "rights_review": {
      "type": "object",
      "required": [
        "status",
        "borrowed_assets"
      ],
      "properties": {
        "status": {
          "enum": [
            "passed",
            "pending",
            "blocked",
            "not-applicable"
          ]
        },
        "borrowed_assets": {
          "type": "array"
        }
      },
      "additionalProperties": true
    },
    "budget": {
      "type": "object",
      "required": [
        "status",
        "currency",
        "line_items",
        "declared_total"
      ],
      "properties": {
        "status": {
          "enum": [
            "specified",
            "not-required-by-brief",
            "open-decision"
          ]
        },
        "currency": {
          "type": [
            "string",
            "null"
          ]
        },
        "line_items": {
          "type": "array"
        },
        "declared_total": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "kpi": {
      "type": "object",
      "required": [
        "status",
        "metrics"
      ],
      "properties": {
        "status": {
          "enum": [
            "specified",
            "not-required-by-brief",
            "open-decision"
          ]
        },
        "metrics": {
          "type": "array"
        }
      },
      "additionalProperties": true
    },
    "aigc": {
      "type": "object",
      "required": [
        "used",
        "record_path"
      ],
      "properties": {
        "used": {
          "enum": [
            "yes",
            "no",
            "unknown"
          ]
        },
        "record_path": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
