{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.student-ad-competition-copilot/schemas/print-ad-run-manifest.schema.json",
  "title": "Print-ad production run manifest",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "competition",
    "category",
    "brief_id",
    "selected_direction",
    "series_mode",
    "run_scope",
    "visual_generation_capability",
    "method_validation_status",
    "artifacts",
    "review_contract"
  ],
  "properties": {
    "schema_version": {
      "const": "0.4.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "competition": {
      "enum": [
        "daguangsai",
        "academy-award"
      ]
    },
    "category": {
      "const": "print-ad"
    },
    "brief_id": {
      "type": "string",
      "minLength": 1
    },
    "selected_direction": {
      "type": "string",
      "minLength": 1
    },
    "series_mode": {
      "enum": [
        "single",
        "series"
      ]
    },
    "run_scope": {
      "enum": [
        "concept-only",
        "production-candidate",
        "delivery-candidate"
      ]
    },
    "visual_generation_capability": {
      "type": "object",
      "required": [
        "status",
        "provider",
        "operations",
        "checked_at",
        "evidence",
        "user_decision",
        "impact_acknowledged"
      ],
      "properties": {
        "status": {
          "enum": [
            "available",
            "unavailable",
            "unknown"
          ]
        },
        "provider": {
          "type": [
            "string",
            "null"
          ]
        },
        "operations": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "generate",
              "edit"
            ]
          }
        },
        "checked_at": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        },
        "user_decision": {
          "enum": [
            "use-available-capability",
            "accept-limited-mode",
            "enable-or-switch-environment",
            "pending"
          ]
        },
        "impact_acknowledged": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "available"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "provider": {
                "type": "string",
                "minLength": 1
              },
              "operations": {
                "contains": {
                  "const": "generate"
                }
              },
              "user_decision": {
                "const": "use-available-capability"
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "method_validation_status": {
      "enum": [
        "not-claimed",
        "method-validated"
      ]
    },
    "method_cards_used": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "method_cards_rejected": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "aigc_used": {
      "enum": [
        "yes",
        "no",
        "unknown"
      ]
    },
    "artifacts": {
      "type": "object",
      "required": [
        "brief_evidence",
        "direction_cards",
        "concept_gate",
        "quality_gate_results",
        "run_status"
      ],
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "review_contract": {
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "run_scope": {
            "enum": [
              "production-candidate",
              "delivery-candidate"
            ]
          }
        },
        "required": [
          "run_scope"
        ]
      },
      "then": {
        "required": [
          "aigc_used"
        ],
        "properties": {
          "visual_generation_capability": {
            "properties": {
              "status": {
                "const": "available"
              }
            }
          },
          "artifacts": {
            "required": [
              "official_asset_manifest",
              "production_manifest",
              "human_visual_review",
              "technical_validation"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "run_scope": {
            "const": "delivery-candidate"
          }
        },
        "required": [
          "run_scope"
        ]
      },
      "then": {
        "properties": {
          "aigc_used": {
            "enum": [
              "yes",
              "no"
            ]
          },
          "artifacts": {
            "required": [
              "delivery_manifest"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "aigc_used": {
            "const": "yes"
          }
        },
        "required": [
          "aigc_used"
        ]
      },
      "then": {
        "properties": {
          "artifacts": {
            "required": [
              "aigc_record"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "method_validation_status": {
            "const": "method-validated"
          }
        },
        "required": [
          "method_validation_status"
        ]
      },
      "then": {
        "required": [
          "method_cards_used",
          "method_cards_rejected"
        ],
        "properties": {
          "artifacts": {
            "required": [
              "method_application"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "run_scope": {
            "enum": [
              "production-candidate",
              "delivery-candidate"
            ]
          }
        },
        "required": [
          "run_scope"
        ]
      },
      "then": {
        "properties": {
          "artifacts": {
            "required": [
              "visual_review"
            ]
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
