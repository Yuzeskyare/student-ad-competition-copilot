{
  "$schema": "../../schemas/track-quality-gates.schema.json",
  "document_type": "gate-definitions",
  "schema_version": "0.1.0",
  "definition_set_id": "print-ad.0.7.0",
  "track": "print-ad",
  "playbook": "playbook.md",
  "gates": [
    {
      "gate_id": "print-ad.brief-evidence",
      "order": 10,
      "stage": "brief",
      "gate_type": "hybrid",
      "purpose": "确认传播任务、官方事实、赛事边界和保真资产足以支持方向探索。",
      "applicability": {
        "mode": "always"
      },
      "required_inputs": [
        "official-rules",
        "official-brief",
        "official-assets"
      ],
      "required_outputs": [
        "brief-evidence",
        "single-communication-task",
        "official-asset-manifest"
      ],
      "checks": [
        {
          "check_id": "identity-and-category",
          "assessment": "machine",
          "question": "赛事、届次、类别、命题和产品身份是否已登记？",
          "pass_condition": "必需身份字段存在且非空。",
          "failure_severity": "hard-stop",
          "return_to_stage": "brief",
          "evidence_required": true
        },
        {
          "check_id": "single-task",
          "assessment": "human",
          "question": "主要传播目的是否符合当前命题分支，且人群、困扰、产品价值与主次明确？",
          "pass_condition": "任务有当前命题依据；支持的行为与应减少的困扰未读反，不以主题字面或执行专项替换传播目的。",
          "failure_severity": "return-on-observed-failure",
          "return_to_stage": "brief",
          "evidence_required": true
        },
        {
          "check_id": "asset-production-readiness",
          "assessment": "human",
          "question": "官方产品、Logo、包装和必备文字是否足以支持拟定构图？",
          "pass_condition": "保真资产来源、用途和限制明确，方向不依赖伪造几何或标签。",
          "applies_when": "准备从概念探索进入高分辨率生产时。",
          "failure_severity": "hard-stop",
          "return_to_stage": "brief",
          "evidence_required": true
        }
      ],
      "hard_stops": [
        {
          "stop_id": "missing-core-identity",
          "condition": "核心品牌、产品或命题身份没有官方证据。",
          "return_to_stage": "brief",
          "required_resolution": "取得官方证据或停止高清生产。"
        },
        {
          "stop_id": "missing-fidelity-asset",
          "condition": "创意依赖必须保真的产品、Logo或包装，但无可用官方资产。",
          "return_to_stage": "brief",
          "required_resolution": "补资产或改为不依赖缺失资产的方向。"
        }
      ],
      "waiver_policy": {
        "allowed": false,
        "reason_required": true,
        "allowed_when": []
      },
      "on_pass": "print-ad.direction-distinctness"
    },
    {
      "gate_id": "print-ad.direction-distinctness",
      "order": 20,
      "stage": "directions",
      "gate_type": "hybrid",
      "purpose": "在现有方向阶段独立去重、盲评强制排序并拦住不可画方向。",
      "applicability": {
        "mode": "always"
      },
      "required_inputs": [
        "brief-evidence",
        "visual-territory-research"
      ],
      "required_outputs": [
        "direction-cards",
        "selected-direction",
        "rejected-direction-reasons",
        "method-retrieval-before-adoption",
        "independent-direction-blind-review-before-adoption"
      ],
      "checks": [
        {
          "check_id": "mechanism-distinctness",
          "assessment": "human",
          "question": "空上下文独立检查者是否先剔除近似方案，留下至少3个真正不同的方向？",
          "pass_condition": "后台至少3个去重后方向，来自不同方法卡或利益角度；独立原始返回登记剔除项和关系理由，作者自判不能替代。",
          "failure_severity": "return-on-observed-failure",
          "return_to_stage": "directions",
          "evidence_required": true
        },
        {
          "check_id": "product-role",
          "assessment": "human",
          "question": "独立检查者只看方向一句话时，如何比较产品利益、意外感和创意本身？",
          "pass_condition": "只看画面动作与产品关系的一句话清单，按本题产品利益是否被直接演出、看到时的意外感与创意本身强弱强制排序，不设绝对分，不使用竞品替换或品牌独占门槛。",
          "failure_severity": "return-on-observed-failure",
          "return_to_stage": "directions",
          "evidence_required": true
        },
        {
          "check_id": "selection-rationale",
          "assessment": "human",
          "question": "独立排序和逐项可画性是否决定采用，且保留用户选择权？",
          "pass_condition": "第一名且单幅接触、尺度、关系可画才可进入出图；全部偏弱最多重新发散1次，再弱就报告边界并停止自动推进。未委托必须有用户选择记录；用户选择其他项时先修订并重新盲评，不能直接越过排名第一与可画门。",
          "failure_severity": "return-on-observed-failure",
          "return_to_stage": "directions",
          "evidence_required": true
        },
        {
          "check_id": "method-retrieval-before-adoption",
          "assessment": "machine",
          "question": "实际方法检索结果和取舍记录是否先于方向采用？",
          "pass_condition": "绑定现有 query_case_library.py 的原始输出、活动包、原问题/回退词、方法 id 与逐项理由及关系/制作输入变化；空结果保留；记录和执行时间严格早于采用。",
          "failure_severity": "hard-stop",
          "return_to_stage": "direction",
          "evidence_required": true
        },
        {
          "check_id": "independent-direction-evidence",
          "assessment": "machine",
          "question": "方向采用是否绑定隔离检查、纯一句话输入/hash、原始返回、排序、可画性及先后顺序？",
          "pass_condition": "print-direction-v1绑定真实记录；每轮新独立调用，最多2轮且仅首轮全部偏弱可再发散；风险提示不能用于写成方向前拒绝方法卡，拒绝须绑定官方硬性约束或已观察具体失败；作者自判不能替代。",
          "failure_severity": "hard-stop",
          "return_to_stage": "directions",
          "evidence_required": true
        }
      ],
      "hard_stops": [
        {
          "stop_id": "style-only-directions",
          "condition": "所有方向只更换风格、背景、配色或标题。",
          "return_to_stage": "directions",
          "required_resolution": "重做视觉因果和对象关系。"
        },
        {
          "stop_id": "missing-blind-review-or-undrawable-winner",
          "condition": "缺独立记录、近似未剔除、非第一/不可画采用、超额发散或未委托自选。",
          "return_to_stage": "directions",
          "required_resolution": "完成同阶段独立盲评及真实选择；不能用作者自判或质量门豁免绕过。"
        }
      ],
      "waiver_policy": {
        "allowed": false,
        "reason_required": true,
        "allowed_when": []
      },
      "on_pass": "print-ad.visual-relation-prototype"
    },
    {
      "gate_id": "print-ad.visual-relation-prototype",
      "order": 30,
      "stage": "prototype",
      "gate_type": "human",
      "purpose": "在高清生产前验证动作、因果、产品作用和短时理解。",
      "applicability": {
        "mode": "always"
      },
      "required_inputs": [
        "selected-direction"
      ],
      "required_outputs": [
        "low-cost-prototype",
        "visual-only-test",
        "thumbnail-test",
        "misread-risk"
      ],
      "checks": [
        {
          "check_id": "visual-only-meaning",
          "assessment": "human",
          "question": "图像承担的表达是否可见，完整图文是否共同成立？",
          "pass_condition": "暂遮文字用于诊断依赖，不普遍要求去字后完整成义；静态/情绪/文字机制按实际关系判断，作者额外长说明不能救失败。 已观察到主关系误读或承诺未兑现时回责任阶段实改，不能只修信息区后维持通过。",
          "failure_severity": "return-on-observed-failure",
          "return_to_stage": "prototype",
          "evidence_required": true
        },
        {
          "check_id": "product-in-relation",
          "assessment": "human",
          "question": "产品特征或利益与本次判断有何联系？",
          "pass_condition": "利益与品牌归属成立，或产品确实参与动作；不强制包装充当机关，不凭放大、位置和接触认定说服。",
          "failure_severity": "return-on-observed-failure",
          "return_to_stage": "prototype",
          "evidence_required": true
        },
        {
          "check_id": "thumbnail-hierarchy",
          "assessment": "human",
          "question": "实际浏览尺度的阅读顺序是否清楚，容器或界面是否有语义？",
          "pass_condition": "焦点和品牌确认可辨；整体真实界面可以成立，无关卡片骨架仍失败。",
          "failure_severity": "hard-stop",
          "return_to_stage": "prototype",
          "evidence_required": true
        }
      ],
      "hard_stops": [
        {
          "stop_id": "explanation-dependent",
          "condition": "画面必须依赖大段创意说明才能理解。",
          "return_to_stage": "prototype",
          "required_resolution": "重做视觉关系，不增加解释性小字。"
        },
        {
          "stop_id": "abstract-action",
          "condition": "所选表达的关键关系在实际图文中不成立；动作型看不出必要作用，静态型缺少预期对比或联系。",
          "return_to_stage": "prototype",
          "required_resolution": "回到具体失败层重建；不强制所有表达拟人化或添加动作。"
        },
        {
          "stop_id": "generic-card-shell",
          "condition": "主要构图依赖重复圆角卡片、网页UI面板或仪表盘外壳，且不能证明真实对象或内容关系语义。",
          "return_to_stage": "prototype",
          "required_resolution": "移除无语义模板，按内容重建；真实界面按实际整体范围核验，不强制局部化。"
        }
      ],
      "waiver_policy": {
        "allowed": false,
        "reason_required": true,
        "allowed_when": []
      },
      "on_pass": "print-ad.official-asset-fidelity"
    },
    {
      "gate_id": "print-ad.official-asset-fidelity",
      "order": 40,
      "stage": "production",
      "gate_type": "hybrid",
      "purpose": "保证生成视觉、官方资产、创意字形和准确信息各自承担正确职责。",
      "applicability": {
        "mode": "always"
      },
      "required_inputs": [
        "low-cost-prototype",
        "official-asset-manifest",
        "production-source-manifest"
      ],
      "required_outputs": [
        "composite-candidate",
        "asset-fidelity-review",
        "aigc-use-declaration"
      ],
      "checks": [
        {
          "check_id": "source-traceability",
          "assessment": "machine",
          "question": "最终产品、Logo和包装资产是否可追溯到登记来源？",
          "pass_condition": "来源路径和用途字段存在。",
          "failure_severity": "hard-stop",
          "return_to_stage": "production",
          "evidence_required": true
        },
        {
          "check_id": "aigc-disclosure",
          "assessment": "machine",
          "question": "是否在交付后提醒用户核对AIGC记录与平台申报？",
          "pass_condition": "交付说明提醒即可；记录未完成、使用情况未确认或平台未申报均不阻断作品交付。",
          "failure_severity": "return-on-observed-failure",
          "return_to_stage": "production",
          "evidence_required": false
        },
        {
          "check_id": "visual-integration",
          "assessment": "human",
          "question": "产品尺度、边缘、色彩和构图是否符合所选视觉语言；需要摄影真实感的部分，其光线、透视、阴影和景深是否成立？",
          "pass_condition": "产品身份保真且参与构图；非摄影语言按其造型与组合规则评价，不因缺少摄影阴影或景深失败。",
          "failure_severity": "return-on-observed-failure",
          "return_to_stage": "production",
          "evidence_required": true
        },
        {
          "check_id": "generated-artifact-scan",
          "assessment": "human",
          "question": "是否存在假字、假Logo、伪包装、伪透明或无意结构缺陷；有意夸张和非现实空间是否符合已选风格且不违背明确命题要求？",
          "pass_condition": "最终候选没有将生成错误作为真实品牌或产品元素。",
          "failure_severity": "hard-stop",
          "return_to_stage": "production",
          "evidence_required": true
        }
      ],
      "hard_stops": [
        {
          "stop_id": "generated-brand-fidelity",
          "condition": "最终产品、Logo、包装文字或品牌证明由模型伪造。",
          "return_to_stage": "production",
          "required_resolution": "删除伪造元素并使用官方资产或确定性对象。"
        }
      ],
      "waiver_policy": {
        "allowed": false,
        "reason_required": true,
        "allowed_when": []
      },
      "on_pass": "print-ad.series-increment"
    },
    {
      "gate_id": "print-ad.series-increment",
      "order": 50,
      "stage": "series",
      "gate_type": "human",
      "purpose": "验证系列同时具有共同机制、真实变量、信息增量和单幅成立能力。",
      "applicability": {
        "mode": "conditional",
        "when": "作品以系列形式生产或赛事要求多幅作品。"
      },
      "required_inputs": [
        "composite-candidates"
      ],
      "required_outputs": [
        "series-invariant-variable-increment-matrix",
        "series-contact-sheet"
      ],
      "checks": [
        {
          "check_id": "shared-mechanism",
          "assessment": "human",
          "question": "各幅是否共享传播判断、视觉机制和品牌规则？",
          "pass_condition": "共同机制可识别，且不是只靠统一底色维持。",
          "failure_severity": "return-on-observed-failure",
          "return_to_stage": "series",
          "evidence_required": true
        },
        {
          "check_id": "real-variation",
          "assessment": "human",
          "question": "各幅是否在场景、动作、视角、证据或叙事步骤上真实变化？",
          "pass_condition": "不是同背景只换标题，也不是完全异构。",
          "failure_severity": "return-on-observed-failure",
          "return_to_stage": "series",
          "evidence_required": true
        },
        {
          "check_id": "information-increment",
          "assessment": "human",
          "question": "每幅为整体增加了什么？",
          "pass_condition": "矩阵中每幅都有独立信息增量且单幅可理解。",
          "failure_severity": "return-on-observed-failure",
          "return_to_stage": "series",
          "evidence_required": true
        }
      ],
      "hard_stops": [
        {
          "stop_id": "copy-swap-series",
          "condition": "系列仅更换文案或背景，没有视觉信息增量。",
          "return_to_stage": "series",
          "required_resolution": "重做变量、动作和递进。"
        }
      ],
      "waiver_policy": {
        "allowed": true,
        "reason_required": true,
        "allowed_when": [
          "命题和交付明确为单幅作品。"
        ]
      },
      "on_pass": "print-ad.human-visual-quality"
    },
    {
      "gate_id": "print-ad.human-visual-quality",
      "order": 60,
      "stage": "content-review",
      "gate_type": "human",
      "purpose": "用三秒、品牌替换、缩略图和全尺寸检查判断作品是否真正成立。 执行final-pixel-review.md，复核目标原生渲染、三种尺度及逐单元观察，技术或联系表通过不能替代。",
      "applicability": {
        "mode": "always"
      },
      "required_inputs": [
        "final-visual-candidates",
        "review-board"
      ],
      "required_outputs": [
        "communication-clarity-review",
        "brand-replacement-review",
        "full-size-review",
        "human-decision",
        "version-bound-final-pixel-evidence",
        "core-creative-pixel-review"
      ],
      "checks": [
        {
          "check_id": "communication-clarity",
          "assessment": "human",
          "question": "实际观看后能否理解主要动作与传播判断，判断方法是否如实记录？",
          "pass_condition": "画面无需作者长解释；定性认可与作者观察分别记录，不冒充计时或独立受众实测。",
          "failure_severity": "return-on-observed-failure",
          "return_to_stage": "prototype",
          "evidence_required": true
        },
        {
          "check_id": "brand-specific-meaning",
          "assessment": "human",
          "question": "恢复品牌后是否增加专属意义，换竞品后是否出现明显损失？",
          "pass_condition": "品牌和产品不是可替换署名。",
          "failure_severity": "return-on-observed-failure",
          "return_to_stage": "directions",
          "evidence_required": true
        },
        {
          "check_id": "local-legibility",
          "assessment": "human",
          "question": "文字、对比和修复是否只针对实际问题，没有形成全局噪音或网页卡片式通用外壳？",
          "pass_condition": "缩略与全尺寸都可读，局部补丁未机械复制；任何卡片均有语义、范围、替代方案和评审证据。",
          "failure_severity": "return-on-observed-failure",
          "return_to_stage": "production",
          "evidence_required": true
        },
        {
          "check_id": "copy-natural-and-supporting",
          "assessment": "human",
          "question": "标题、对白或正文是否像目标场景中的真实语言，并与视觉分工？",
          "pass_condition": "语言自然可说，补充视觉判断而非使用流程术语或替画面解释。",
          "failure_severity": "return-on-observed-failure",
          "return_to_stage": "production",
          "evidence_required": true
        },
        {
          "check_id": "core-creative-pixel-review",
          "assessment": "human",
          "question": "每个完整稿是否由仅接收成图、官方产品资产与一句核心关系声明的独立检查者完成五问？",
          "pass_condition": "独立五问均通过；作者自答无效。像素关系兑现且创意非普通场景；允许有意夸张与超现实。检查输入/返回/hash/身份与时间绑定当前成图，交付前完成；任一失败完整返工并用新图独立复查，局部修改不能冲销。",
          "failure_severity": "return-on-observed-failure",
          "return_to_stage": "direction",
          "evidence_required": true
        }
      ],
      "hard_stops": [
        {
          "stop_id": "brand-replaceable",
          "condition": "换成其他品牌或产品后创意无损成立。",
          "return_to_stage": "directions",
          "required_resolution": "重建产品机制与品牌资产作用。"
        }
      ],
      "waiver_policy": {
        "allowed": false,
        "reason_required": true,
        "allowed_when": []
      },
      "on_pass": "print-ad.technical-delivery"
    },
    {
      "gate_id": "print-ad.technical-delivery",
      "order": 70,
      "stage": "technical-review",
      "gate_type": "machine",
      "purpose": "验证实际提交文件的客观规格、数量、记录和哈希。",
      "applicability": {
        "mode": "always"
      },
      "required_inputs": [
        "final-files",
        "delivery-manifest",
        "aigc-use-declaration",
        "submission-profile"
      ],
      "required_outputs": [
        "technical-validation"
      ],
      "checks": [
        {
          "check_id": "file-specification",
          "assessment": "machine",
          "question": "格式、尺寸、方向、分辨率、颜色模式和大小是否满足当前profile？",
          "pass_condition": "所有适用技术项通过。",
          "failure_severity": "return-on-observed-failure",
          "return_to_stage": "technical-review",
          "evidence_required": true
        },
        {
          "check_id": "submission-file-scope",
          "assessment": "machine",
          "question": "验证范围是否只包含实际提交文件？",
          "pass_condition": "联系表和预览图没有被计入作品数量。",
          "failure_severity": "return-on-observed-failure",
          "return_to_stage": "technical-review",
          "evidence_required": true
        },
        {
          "check_id": "manifest-and-aigc",
          "assessment": "machine",
          "question": "最终作品、清单、哈希和运行路径是否一致？",
